# docker compose 가 읽는 파일. 복사해서 쓴다: cp .env.example .env
# (.env 는 .gitignore 대상 - 실제 값은 커밋하지 않는다)

# --- 관리자 ---
# 공지 작성/수정/삭제 권한. 비워두면 compose 가 기동을 거부한다.
# 화면의 관리자 버튼을 숨겨도 /api/notices/auth 는 열려 있으므로
# 실제 잠금은 이 값 하나다.
ADMIN_PASSWORD=

# 관리자 토큰 서명 키. `openssl rand -hex 32` 로 뽑는다.
# 비워두면 프로세스마다 랜덤이라 재배포 때마다 로그인이 풀린다.
SECRET_KEY=

# --- 노출 포트 ---
# 호스트 nginx 가 프록시할 포트. 같은 서버의 다른 서비스와 겹치면 안 된다.
# 알려진 사용: 8000 meetup-web, 8018/8019 stack-health,
#             8020 btc-daily-web, 8021 ai-daily-web
# 127.0.0.1 에만 바인딩된다(docker-compose.yml) - 외부에서 직접 접근할 수 없다.
WEB_PORT=8022

# --- 도메인 ---
# TLS 와 서버 블록은 호스트 nginx 가 처리한다(컨테이너는 평문 HTTP 로만 뜬다).
DOMAIN=onebitebitcoin.com
